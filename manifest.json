{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.5.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "tr",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "shared/settings.js",
        "highlight/store.js",
        "highlight/anchor.js",
        "highlight/nav.js",
        "highlight/frames.js",
        "highlight/init.js",
        "content/state.js",
        "content/unlock.js",
        "content/bubble-styles.js",
        "content/bubble.js",
        "content/icons.js",
        "content/bubble-dom.js",
        "content/clipboard.js",
        "content/selection.js",
        "content/panel.js",
        "content/highlight-ui.js",
        "content/events.js",
        "content/main.js"
      ],
      "css": [
        "highlight.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{2e40d815-7c2e-4e47-ae07-8a3edbd04219}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}